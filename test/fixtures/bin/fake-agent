#!/bin/sh
# A conversation-aware CLI fixture shared by headless and interactive takeover tests.
session=12345678-1234-1234-1234-123456789abc
if [ "$1" = "--version" ]; then echo 'codex-cli 0.162.1'; exit 0; fi
if [ "$1" = "create-chat" ]; then echo "$session"; exit 0; fi
resume=
last_message=
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output-last-message) shift; last_message="$1" ;;
    resume) resume=yes ;;
    --resume|--session) resume=yes; shift; session="$1" ;;
    12345678-1234-1234-1234-123456789abc) session="$1" ;;
  esac
  shift
done
if [ -n "$resume" ]; then
  parent=$$
  watcher=
  # The readiness marker lets tests finish immediately; install signal handlers first.
  trap 'kill "$watcher" 2>/dev/null; exit 0' USR1
  trap 'kill "$watcher" 2>/dev/null; exit 143' TERM INT HUP
  printf '%s' "$session" > resumed-id.txt
  pwd > resumed-cwd.txt
  echo 'RESUMED CONTEXT'
  if [ -n "$PACER_FAKE_RESUME_FAIL" ]; then echo 'invalid session id' >&2; exit 2; fi
  (while [ ! -f finish-session ]; do sleep 1; done; kill -USR1 "$parent") &
  watcher=$!
  read -r line
  kill "$watcher" 2>/dev/null
  exit 0
fi
echo "session id: $session" >&2
echo 'headless change' > takeover-change.txt
if [ "${PACER_FAKE_COMPLETE:-}" = 1 ]; then
  if [ -n "$last_message" ]; then
    echo 'Created takeover-change.txt; ready for review.' > "$last_message"
  fi
  echo 'Created takeover-change.txt; ready for review.'
  exit 0
fi
trap 'exit 143' TERM INT HUP
while :; do sleep 1; done
