exports[`agent disconnect restores preexisting file bytes exactly 1`] = `
{
  "agents": ""# User note\\r\\nKeep this line.\\r\\n\\n<!-- >>> pacer >>> -->\\nThis applies only when you are the planner pacer is configured for; if pacer started you as an executor (PACER_ROLE=executor), ignore it.\\n# pacer delegation policy (Codex is the planner)\\n\\nYour role: plan, decide and review; delegate execution.\\n\\nThe budget block arrives at session start. Read it before choosing work or an executor.\\n\\n## Modes\\n\\n| Mode | How to work |\\n| --- | --- |\\n| strict/emergency | Delegate execution to available executors; reserve planner budget for decisions and review. |\\n| normal | Delegate substantial execution work; keep planning and review with the planner. |\\n| relaxed | You may execute directly or delegate when useful. |\\n\\n## Delegation workflow\\n\\nUse the installed \`pacer\` skill for CLI routing, brief files, waiting and review.\\nRun \`pacer route <kind> --json\`, then \`pacer delegate --brief-file <path|-> --json\`.\\nReview the diff and run acceptance before \`pacer review <id> --accept|--reject\`. Use \`pacer msg send <id> \\"…\\"\` for follow-ups; it continues the same agent and worktree.\\n\\n## Subagents\\n\\n**Codex subagents count as you doing the work**.\\nA hook blocks them for execution work unless the mode is \`relaxed\`, no executor is available, or \`PACER=off\`. Read-only helpers and reviewers stay allowed.\\n\\n## Review and completion\\n\\nReview each delegated result and verify before reporting done. Check the changes and run the acceptance command; then run \`pacer review <id> --accept|--reject [--kind <k>]\` to record your verdict and any corrected kind tag.\\n\\nWhen a human decision is needed, use \`pacer task request-review <id> --note \\"<specific concern>\\"\` (or MCP task_request_review) instead of recording a verdict you have not reached. Successful execution alone never means acceptance. A completed run without a verdict stays in history and does not require a second human acknowledgment.\\n\\nEscape hatch: set \`PACER=off\` to disable pacing and delegation enforcement for the session.\\n<!-- <<< pacer <<< -->\\n"",
  "hooks": ""{\\n  \\"hooks\\": {\\n    \\"SessionStart\\": [\\n      {\\n        \\"hooks\\": [\\n          {\\n            \\"command\\": \\"user start\\"\\n          }\\n        ]\\n      },\\n      {\\n        \\"hooks\\": [\\n          {\\n            \\"command\\": \\"pacer status --hook codex\\",\\n            \\"timeout\\": 15,\\n            \\"type\\": \\"command\\",\\n            \\"statusMessage\\": \\"Checking subscription budgets\\"\\n          }\\n        ]\\n      }\\n    ],\\n    \\"PreToolUse\\": [\\n      {\\n        \\"matcher\\": \\"spawn_agent\\",\\n        \\"hooks\\": [\\n          {\\n            \\"command\\": \\"pacer guard --planner codex\\",\\n            \\"timeout\\": 15,\\n            \\"type\\": \\"command\\"\\n          }\\n        ]\\n      }\\n    ],\\n    \\"Stop\\": [\\n      {\\n        \\"hooks\\": [\\n          {\\n            \\"command\\": \\"pacer msg hook stop --planner codex\\",\\n            \\"timeout\\": 10,\\n            \\"type\\": \\"command\\"\\n          }\\n        ]\\n      }\\n    ],\\n    \\"UserPromptSubmit\\": [\\n      {\\n        \\"hooks\\": [\\n          {\\n            \\"command\\": \\"pacer msg hook prompt --planner codex\\",\\n            \\"timeout\\": 10,\\n            \\"type\\": \\"command\\"\\n          }\\n        ]\\n      }\\n    ]\\n  },\\n  \\"other\\": true\\n}\\n"",
  "manifest": ""{\\n  \\"version\\": 1,\\n  \\"planners\\": {\\n    \\"codex\\": {\\n      \\"planner\\": \\"codex\\",\\n      \\"installedAt\\": 1791658800,\\n      \\"pacerArgv\\": [\\n        \\"pacer\\"\\n      ],\\n      \\"files\\": [\\n        {\\n          \\"path\\": \\"$HOME/.codex/skills/pacer/SKILL.md\\",\\n          \\"action\\": \\"created\\",\\n          \\"exact\\": true,\\n          \\"undo\\": [],\\n          \\"afterHash\\": \\"b865ac525efb80816144bc45f719512486cbb7046cd38341360c0e8c2ef5721c\\",\\n          \\"managed\\": {\\n            \\"schema\\": 1,\\n            \\"hash\\": \\"b865ac525efb80816144bc45f719512486cbb7046cd38341360c0e8c2ef5721c\\"\\n          }\\n        },\\n        {\\n          \\"path\\": \\"$HOME/.codex/AGENTS.md\\",\\n          \\"action\\": \\"edited\\",\\n          \\"backup\\": \\"$HOME/.codex/AGENTS.md.pacer-bak-<local-time>\\",\\n          \\"exact\\": true,\\n          \\"undo\\": [\\n            {\\n              \\"kind\\": \\"block\\",\\n              \\"style\\": \\"md\\"\\n            }\\n          ],\\n          \\"afterHash\\": \\"eba0ca09bb756a812f226eb5dc1b7a840c5f288261be588162a1f2044d1edb7b\\",\\n          \\"managed\\": {\\n            \\"schema\\": 1,\\n            \\"hash\\": \\"3fb7008dcf09aae68d61d18ef03adaf3e02c460e6a79473468b8276f77cdfda2\\"\\n          }\\n        },\\n        {\\n          \\"path\\": \\"$HOME/.codex/hooks.json\\",\\n          \\"action\\": \\"edited\\",\\n          \\"backup\\": \\"$HOME/.codex/hooks.json.pacer-bak-<local-time>\\",\\n          \\"exact\\": true,\\n          \\"undo\\": [\\n            {\\n              \\"kind\\": \\"hooks\\",\\n              \\"format\\": \\"claude\\",\\n              \\"commands\\": [\\n                \\"pacer status --hook codex\\",\\n                \\"pacer guard --planner codex\\",\\n                \\"pacer msg hook stop --planner codex\\",\\n                \\"pacer msg hook prompt --planner codex\\"\\n              ],\\n              \\"restore\\": []\\n            }\\n          ],\\n          \\"afterHash\\": \\"93536a504ae1b915f5d3464e07b2213a104132aa0962d217b234d2854c67bcdf\\",\\n          \\"managed\\": {\\n            \\"schema\\": 1,\\n            \\"hash\\": \\"d96a5bdaa8706a982cc3e60cffc010419683c4e5bf6c23da2d44a4613953af76\\"\\n          }\\n        }\\n      ],\\n      \\"commands\\": [],\\n      \\"notes\\": [\\n        \\"Codex may ask you to review and trust the new pacer hooks the next time it starts.\\"\\n      ],\\n      \\"mcp\\": false,\\n      \\"folder\\": \\"$HOME/.codex\\"\\n    }\\n  }\\n}\\n"",
}
