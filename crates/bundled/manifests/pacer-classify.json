{
  "id": "pacer-classify",
  "version": "0.2.0",
  "publisher": "pacer",
  "host": "^1.6",
  "contributes": {
    "classifier": {
      "adapters": [
        "rules",
        "ollama",
        "jev"
      ]
    }
  },
  "capabilities": [
