            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/__schema0"
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "strategy_show",
      "description": "Show a strategy YAML and summary. Always preview first and show the user the ranking change. Save only after the user agrees, with a reason. Never switch unless asked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "strategy_use",
      "description": "Switch the active strategy only when explicitly asked. Always preview first and show the user the ranking change. Save only after the user agrees, with a reason. Never switch unless asked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_answer",
      "description": "Answer an executor question. A local task with a resumable session continues in that session once project policy admits it; otherwise the task is retried on the same executor. Only needs_input tasks can be answered.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expect_rev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "task_id",
          "text"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_request_review",
      "description": "Ask a human to decide about a completed result. Give the specific concern; this does not accept the work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expect_rev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "task_id",
          "note"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_review",
