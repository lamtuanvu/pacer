          "verdict"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_send",
      "description": "Send one message into a running interactive lane's live agent (delegate --interactive); a lane waiting on its question is answered with task_answer instead. Refused when the agent is not in its terminal's foreground, or while another client drove the lane in the last 60 seconds unless force.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "force": {
            "type": "boolean"
          },
          "expect_rev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "task_id",
          "text"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_status",
      "description": "Current state and result of a delegated task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_stop",
      "description": "Stop a delegated task and kill its executor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "task_wait",
      "description": "Block until a delegated task finishes or timeout_s passes (default 600, max 3000), then return its state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3000
          }
        },
        "required": [
          "task_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "tree_status",
      "description": "Turn state of every node in a task tree.",
      "inputSchema": {
        "type": "object",
