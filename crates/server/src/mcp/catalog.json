                "type": "string"
              }
            },
            "required": [
              "from"
            ]
          }
        },
        "required": [
          "draft"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "definitions": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/__schema0"
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "strategy_save",
      "description": "Save a validated draft. Replacing the active strategy changes live routing and requires overwrite:true and activeOk:true. Always preview first and show the user the ranking change. Save only after the user agrees, with a reason. Never switch unless asked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "draft": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "set": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/__schema0"
                }
              },
              "unset": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "from"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "overwrite": {
            "type": "boolean"
          },
          "activeOk": {
            "type": "boolean"
          },
          "who": {
            "description": "Agent identity for the creation header",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
