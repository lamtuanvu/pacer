          },
          "executor": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "boilerplate",
              "tests",
              "docs",
              "rename",
              "migration",
              "feature",
              "debug",
              "refactor",
              "performance",
              "unfamiliar-code",
              "research"
            ]
          },
          "note": {
            "type": "string"
          },
          "expect_rev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
