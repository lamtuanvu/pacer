{
  "planner": [
    {
      "name": "budget_status",
      "description": "Budget status for every subscription: usage vs pace, verdicts, the planner's mode and the ranked executors. Call at session start and before large delegation decisions.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "delegate",
      "description": "Hand an execution task to an executor (chosen by budget and priority unless `executor` is given). Returns a task_id immediately; poll with task_status or block with task_wait. Review the diff yourself before reporting done, then call task_review.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dispatch": {},
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Short task title (trimmed, 1–60 characters), stored separately from the full goal. Omitted titles are derived from the first goal clause with paths, URLs and backticked code removed and word-boundary truncation with an ellipsis. Snapshot tasks, task events, task.get, task.list, attention titles and activity text expose this title; older tasks derive it on read."
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "enum": [
              "planner",
              "ui",
              "cli"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          },
          "acceptance_pipefail": {
            "type": "boolean"
          },
          "acceptance_timeout_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "constraints": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "boilerplate",
              "tests",
              "docs",
              "rename",
              "migration",
              "feature",
              "debug",
              "refactor",
              "performance",
              "unfamiliar-code",
              "research"
            ]
          },
          "executor": {
            "type": "string"
          },
          "worktree_base": {
            "type": "string",
            "enum": [
              "default",
              "head"
            ]
          },
          "worktree": {
            "type": "string",
            "enum": [
              "current",
              "new",
              "auto"
            ]
          },
          "worktree_reason": {
            "type": "string",
            "maxLength": 200
          },
          "timeout_min": {
            "type": "number",
            "minimum": 1,
            "maximum": 240
          },
          "interactive": {
            "type": "boolean"
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
          },
          "messaging": {
            "type": "object",
            "properties": {
              "rules": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "effect": {
                      "type": "string",
                      "enum": [
                        "allow",
                        "deny"
                      ]
                    },
                    "from_kind": {
                      "type": "string",
                      "enum": [
                        "human",
                        "external",
                        "launched",
                        "broker",
                        "any"
                      ]
                    },
                    "to_kind": {
                      "type": "string",
                      "enum": [
                        "human",
                        "external",
                        "launched",
                        "broker",
                        "any"
                      ]
                    },
                    "from_position": {
                      "type": "string",
                      "enum": [
                        "top",
                        "child",
                        "any"
                      ]
                    },
                    "relation": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "any"
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "self",
                              "parent",
                              "child",
                              "sibling",
                              "descendant",
                              "ancestor",
                              "top_peer",
                              "same_tree",
                              "none"
                            ]
                          }
                        }
                      ]
                    },
                    "kinds": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "message",
                          "question",
                          "answer",
                          "report",
                          "nudge",
                          "close"
                        ]
                      }
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "executor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "grant": {
                      "type": "string",
                      "enum": [
                        "required",
                        "not_required"
                      ]
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "per_minute": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max_bytes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1048576
                        },
                        "confirm": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "effect"
                  ],
                  "additionalProperties": false
                }
              },
              "max_turns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "liveness": {
                "type": "object",
                "properties": {
                  "interval_s": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 9007199254740991
                  },
                  "max_nudges": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "escalate_after_s": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "grant": {
            "type": "boolean"
          }
        },
        "required": [
          "goal",
          "repo"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "dispatch_preview",
      "description": "Preview model/account selection with reasons and uncertainty. Uses cached observations; launches nothing and changes no strategy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requirements": {
            "default": {},
            "type": "object",
            "properties": {
              "minTier": {
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "frontier"
                ]
              },
              "tools": {
                "type": "boolean"
              },
              "context": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "preferences": {
            "default": {
              "models": [],
              "strengths": []
            },
            "type": "object",
            "properties": {
              "models": {
                "default": [],
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "strengths": {
                "default": [],
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "additionalProperties": false
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "delegationEnforcement": {
            "type": "string",
            "enum": [
              "strict",
              "cooperative"
            ]
          }
        },
        "required": [
          "repo",
          "goal"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "guard_feedback",
      "description": "Report that pacer's subagent guard decided wrongly (or rightly) for a given event.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "correct": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "correct"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_close",
      "description": "Close a task you started for further messages. Records no review verdict.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_inbox",
      "description": "Unread messages addressed to you.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_log",
      "description": "A task's message thread.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_policy",
      "description": "The effective messaging guardrail, or which rule decides a hypothetical send (check).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "check": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "message",
                  "question",
                  "answer",
                  "report",
                  "nudge",
                  "close"
                ]
              },
              "grant": {
                "type": "boolean"
              }
            },
            "required": [
              "from",
              "to",
              "kind"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_read",
      "description": "Mark your messages read so msg_wait blocks until new ones arrive.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_send",
      "description": "Send a message to an agent. A message to a finished delegated task continues its native session in the same worktree; its reply arrives as a report in your inbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "message",
              "question",
              "answer"
            ]
          },
          "reply_to": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "to",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "msg_wait",
      "description": "Block until a message or a reply arrives (timeout_s default 600, max 3000).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reply_to": {
            "type": "string"
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3000
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "report_limit",
      "description": "Tell pacer an executor hit its plan limit (seen outside pacer). It is skipped until `until` (unix seconds) or its cooldown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "until": {
            "type": "number"
          }
        },
        "required": [
          "provider"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "route",
      "description": "Which executors pacer would use for a task kind, in order, with reasons and exclusions. Runs nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "boilerplate",
              "tests",
              "docs",
              "rename",
              "migration",
              "feature",
              "debug",
              "refactor",
              "performance",
              "unfamiliar-code",
              "research"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "strategy_list",
      "description": "List strategies and their summaries. Always preview first and show the user the ranking change. Save only after the user agrees, with a reason. Never switch unless asked.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
