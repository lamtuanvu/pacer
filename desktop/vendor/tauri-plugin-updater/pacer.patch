+    // Pacer regression: exercise a real filesystem denial without allowing the
+    // upstream fallback to schedule AppleScript. The callback only records attempts.
+    #[test]
+    #[cfg(all(target_os = "macos", feature = "no-elevation"))]
+    fn pacer_permission_denied_never_requests_elevation() {
+        use std::os::unix::fs::PermissionsExt;
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let dir = tempfile::tempdir().unwrap();
+        let parent = dir.path().join("installed");
+        let target = parent.join("Probe.app");
+        std::fs::create_dir_all(&target).unwrap();
+        std::fs::write(target.join("version"), "old").unwrap();
+        let encoder = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+        let mut archive = tar::Builder::new(encoder);
+        let mut header = tar::Header::new_gnu();
+        header.set_size(3);
+        header.set_mode(0o644);
+        header.set_cksum();
+        archive.append_data(&mut header, "Probe.app/version", &b"new"[..]).unwrap();
+        let bytes = archive.into_inner().unwrap().finish().unwrap();
+        let mut update = updater().restore_update(manifest()).unwrap().unwrap();
+        update.extract_path = target.clone();
+        let attempts = Arc::new(AtomicUsize::new(0));
+        let observed = attempts.clone();
+        update.context.run_on_main_thread = Arc::new(move |_callback| {
+            observed.fetch_add(1, Ordering::SeqCst);
+            // Deliberately drop the callback: never display a privilege prompt.
+            Ok(())
+        });
+        std::fs::set_permissions(&parent, std::fs::Permissions::from_mode(0o500)).unwrap();
+        let result = update.install_inner(&bytes);
+        std::fs::set_permissions(&parent, std::fs::Permissions::from_mode(0o700)).unwrap();
+        assert_eq!(attempts.load(Ordering::SeqCst), 0, "permission denial attempted elevation");
+        assert!(matches!(result, Err(Error::Io(ref error)) if error.kind() == std::io::ErrorKind::PermissionDenied), "{result:?}");
+        assert_eq!(std::fs::read_to_string(target.join("version")).unwrap(), "old");
     }
 
