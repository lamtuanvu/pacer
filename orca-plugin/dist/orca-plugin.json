{
  "manifestVersion": 1,
  "id": "pacer",
  "publisher": "lamtuanvu",
  "repository": "https://github.com/lamtuanvu/pacer",
  "name": "pacer",
  "version": "0.1.24",
  "description": "pacer's budget and task status at a glance. Act in the pacer app or `pacer dashboard`.",
  "engines": {
    "orca": ">=1.4.224"
  },
  "pluginApi": 1,
  "main": "worker.mjs",
  "icon": "assets/pacer-mark.svg",
  "contributes": {
    "panels": [
      {
        "id": "budget",
        "title": "pacer",
        "icon": "gauge",
        "entry": "panel/live.html"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "pacer: Open",
        "context": "global"
      }
    ],
    "events": []
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "storage"
    },
    {
      "kind": "settings:own"
    }
  ]
}
