{
  "manifestVersion": 1,
  "id": "pacer-spike",
  "publisher": "pacer",
  "name": "pacer link spike",
  "version": "0.0.1",
  "description": "Throwaway probe for the pacer brain link. Remove after the spike.",
  "engines": { "orca": ">=1.4.224" },
  "pluginApi": 1,
  "main": "worker.mjs",
  "contributes": {
    "panels": [{ "id": "probe", "title": "pacer spike", "icon": "flask-conical", "entry": "panel.html" }],
    "commands": [
      { "id": "probe-http", "title": "pacer spike: probe http", "context": "global" },
      { "id": "probe-storage", "title": "pacer spike: probe storage", "context": "global" },
      { "id": "probe-send", "title": "pacer spike: probe terminal send", "context": "worktree" }
    ],
    "events": [{ "on": "agent.status.changed" }, { "on": "worktree.created" }]
  },
  "capabilities": [
    { "kind": "workspace:read" }, { "kind": "terminal:send" }, { "kind": "notifications:show" },
    { "kind": "events:subscribe" }, { "kind": "storage" }, { "kind": "settings:own" }
  ]
}
