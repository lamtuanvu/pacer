{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pacer plugin protocol 1.0.0",
  "$defs": {
    "manifest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host": {
          "type": "string",
          "pattern": "^(\\^|~|>=)?\\d+(\\.\\d+){0,2}$|^\\*$"
        },
        "contributes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "diagnostic"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "tasks.read",
                  "events.subscribe",
                  "process.spawn",
                  "fs.read",
                  "net.http",
                  "secrets.resolve",
                  "config.get",
                  "entitlement.report",
                  "log"
                ]
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "reentrant": {
          "default": false,
          "type": "boolean"
        },
        "tier": {
          "default": "free",
          "type": "string",
          "enum": [
            "free",
            "commercial"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "publisher",
        "host",
        "contributes",
        "capabilities",
        "reentrant",
        "tier"
      ],
      "additionalProperties": false,
      "$defs": {
        "__schema0": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          ]
        }
      }
    },
    "helloParams": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string"
        },
        "pacer": {
          "type": "string"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
