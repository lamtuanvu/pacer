{
  "id": "pacer-usage",
  "version": "0.2.0",
  "publisher": "pacer",
  "host": "^1.6",
  "contributes": {
    "usage": {
      "providers": [
        "claude-code",
        "codex",
        "arkcli",
        "metered"
      ]
    }
  },
  "capabilities": [
    {
      "name": "fs.read",
      "scopes": [
        "${PACER_HOME}/cache/claude-rate-limits*.json",
        "${HOME}/.claude/state/budget/claude.json",
        "${ACCOUNT_HOME}/state/budget/claude.json",
        "${ACCOUNT_HOME}/sessions/**/rollout-*.jsonl"
      ]
    },
    {
      "name": "process.spawn",
      "scopes": [
        "arkcli",
        "opencode",
        "codex"
      ]
    },
    {
      "name": "usage.state"
    }
  ],
  "reentrant": true,
  "tier": "free"
}
